@page
@model SonrisaDerrisa.Web.Pages.Reportes.SaldosModel
@{ ViewData["Title"] = "Reporte de saldos"; }

<h1 class="h3 mb-3">Reporte de saldos por cita</h1>

<form method="get" class="row g-2 mb-3 align-items-center">
    <div class="col-sm-6 col-md-4">
        <input class="form-control" asp-for="Paciente" placeholder="Paciente" />
    </div>
    <div class="col-auto form-check ms-2">
        <input class="form-check-input" type="checkbox" name="SoloPendientes" value="true" id="sp" @(Model.SoloPendientes ? "checked" : "") />
        <label class="form-check-label" for="sp">Solo con saldo pendiente</label>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary">Consultar</button>
        <a class="btn btn-link" asp-page="Saldos">Limpiar</a>
    </div>
</form>

@if (Model.Lista.Count == 0)
{
    <div class="vacio">No hay citas atendidas que cumplan los criterios.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover bg-white align-middle">
            <thead><tr><th>Cita</th><th>Fecha</th><th>Paciente</th><th>Dentista</th><th class="text-end">Total</th><th class="text-end">Pagado</th><th class="text-end">Saldo</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in Model.Lista)
                {
                    <tr>
                        <td>#@s.IdCita</td>
                        <td>@s.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@s.Paciente</td>
                        <td>@s.Dentista</td>
                        <td class="text-end">@s.Total.ToString("C")</td>
                        <td class="text-end">@s.Pagado.ToString("C")</td>
                        <td class="text-end fw-bold @(s.Saldo > 0 ? "text-danger" : "text-success")">@s.Saldo.ToString("C")</td>
                        <td class="text-end">
                            @if (s.Saldo > 0) { <a class="btn btn-sm btn-outline-success" asp-page="/Citas/Pago" asp-route-id="@s.IdCita">Abonar</a> }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="4">Totales (@Model.Lista.Count citas)</td>
                    <td class="text-end">@Model.Lista.Sum(s => s.Total).ToString("C")</td>
                    <td class="text-end">@Model.Lista.Sum(s => s.Pagado).ToString("C")</td>
                    <td class="text-end">@Model.Lista.Sum(s => s.Saldo).ToString("C")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
}
