@page "{id:int}"
@model SonrisaDerrisa.Web.Pages.Citas.PagoModel
@{ ViewData["Title"] = $"Registrar pago · cita #{Model.Id}"; }

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<div class="row g-3 mb-3" style="max-width: 760px">
    <div class="col-4"><div class="card card-resumen"><div class="card-body py-2"><div class="small text-muted">Total</div><strong>@Model.Cuenta!.Total.ToString("C")</strong></div></div></div>
    <div class="col-4"><div class="card card-resumen"><div class="card-body py-2"><div class="small text-muted">Pagado</div><strong>@Model.Cuenta.Pagado.ToString("C")</strong></div></div></div>
    <div class="col-4"><div class="card card-resumen"><div class="card-body py-2"><div class="small text-muted">Saldo</div><strong>@Model.Cuenta.Saldo.ToString("C")</strong></div></div></div>
</div>
<p class="text-muted">@Model.Cuenta.Paciente · @Model.Cuenta.Dentista · @Model.Cuenta.Fecha.ToString("dd/MM/yyyy")</p>

<form method="post" class="bg-white p-3 rounded shadow-sm" style="max-width: 760px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label" asp-for="Monto">Monto *</label>
            <input class="form-control" asp-for="Monto" type="number" step="0.01" />
            <span asp-validation-for="Monto" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label class="form-label" asp-for="Metodo">Método *</label>
            <select class="form-select" asp-for="Metodo">
                <option value="">Seleccione…</option>
                <option>Efectivo</option><option>Tarjeta</option><option>Transferencia</option>
            </select>
            <span asp-validation-for="Metodo" class="text-danger small"></span>
        </div>
    </div>
    <div class="mt-4">
        <button class="btn btn-success">Registrar pago</button>
        <a class="btn btn-outline-secondary" asp-page="Index">Volver</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
