@page "{id:int}"
@model SonrisaDerrisa.Web.Pages.Citas.AtenderModel
@{ ViewData["Title"] = $"Atender cita #{Model.Id}"; }

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<div class="bg-white p-3 rounded shadow-sm mb-3" style="max-width: 760px">
    <strong>@Model.Cita!.Paciente</strong> con @Model.Cita.Dentista ·
    @Model.Cita.Fecha.ToString("dd/MM/yyyy") @Model.Cita.Hora.ToString(@"hh\:mm")
    @if (Model.Cita.Alergias != null)
    {
        <div class="alert alert-warning mt-2 mb-0 py-2">⚠ Alergias: @Model.Cita.Alergias</div>
    }
</div>

<form method="post" class="bg-white p-3 rounded shadow-sm" style="max-width: 760px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <h2 class="h6 text-muted">Tratamiento realizado</h2>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label" asp-for="IdTratamiento">Tratamiento *</label>
            <select class="form-select" asp-for="IdTratamiento">
                <option value="0">Seleccione…</option>
                @foreach (var t in Model.Tratamientos)
                {
                    <option value="@t.Id">@t.Texto (@t.Precio.ToString("C"))</option>
                }
            </select>
            <span asp-validation-for="IdTratamiento" class="text-danger small"></span>
        </div>
        <div class="col-md-2">
            <label class="form-label" asp-for="Diente">Diente</label>
            <input class="form-control" asp-for="Diente" maxlength="2" placeholder="36" />
            <span asp-validation-for="Diente" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label class="form-label" asp-for="Precio">Precio aplicado</label>
            <input class="form-control" asp-for="Precio" type="number" step="0.01" placeholder="Precio base" />
            <span asp-validation-for="Precio" class="text-danger small"></span>
        </div>
    </div>
    <h2 class="h6 text-muted mt-4">Abono inicial (opcional)</h2>
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label" asp-for="Abono">Monto</label>
            <input class="form-control" asp-for="Abono" type="number" step="0.01" />
            <span asp-validation-for="Abono" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label class="form-label" asp-for="Metodo">Método de pago</label>
            <select class="form-select" asp-for="Metodo">
                <option value="">—</option>
                <option>Efectivo</option><option>Tarjeta</option><option>Transferencia</option>
            </select>
        </div>
    </div>
    <div class="mt-4">
        <button class="btn btn-success">Confirmar atención</button>
        <a class="btn btn-outline-secondary" asp-page="Index">Volver</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
