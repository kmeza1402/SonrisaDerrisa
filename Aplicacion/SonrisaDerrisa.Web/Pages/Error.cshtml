@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="error-screen">
    <div class="error-icon" aria-hidden="true">@(Model.EsErrorBaseDatos ? "⌁" : "!")</div>
    <span class="eyebrow">Sonrisa Derrisa</span>
    <h1>@Model.Titulo</h1>
    <p class="error-message">@Model.Mensaje</p>

    @if (Model.EsErrorBaseDatos)
    {
        <div class="error-help">
            <strong>Qué puedes hacer</strong>
            <ul>
                <li>Comprueba que el servidor de base de datos esté encendido.</li>
                <li>Espera unos segundos y vuelve a intentarlo.</li>
                <li>Si el problema continúa, informa al administrador.</li>
            </ul>
        </div>
    }

    <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
        <button class="btn btn-primary" type="button" onclick="location.reload()">Intentar nuevamente</button>
        <a class="btn btn-outline-primary" asp-page="/Index">Volver al inicio</a>
    </div>

    @if (Model.ShowRequestId)
    {
        <p class="error-reference mt-4 mb-0">Referencia: <code>@Model.RequestId</code></p>
    }
</div>
