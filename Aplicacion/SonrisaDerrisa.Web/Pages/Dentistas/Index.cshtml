@page
@model SonrisaDerrisa.Web.Pages.Dentistas.IndexModel
@{ ViewData["Title"] = "Dentistas"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Dentistas</h1>
    <a class="btn btn-primary" asp-page="Editar">Nuevo dentista</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-5">
        <input class="form-control" asp-for="Buscar" placeholder="Nombre o cédula" />
    </div>
    <div class="col-sm-4 col-md-3">
        <select class="form-select" asp-for="Especialidad" asp-items="Model.Especialidades">
            <option value="0">Todas las especialidades</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary">Filtrar</button>
        <a class="btn btn-link" asp-page="Index">Limpiar</a>
    </div>
</form>

@if (Model.Lista.Count == 0)
{
    <div class="vacio">No hay dentistas registrados con esos criterios.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover bg-white align-middle">
            <thead><tr><th>Dentista</th><th>Cédula</th><th>Especialidad</th><th>Teléfono</th><th>Citas</th><th></th></tr></thead>
            <tbody>
                @foreach (var d in Model.Lista)
                {
                    <tr>
                        <td>@d.NombreCompleto</td>
                        <td>@d.Cedula</td>
                        <td>@d.Especialidad</td>
                        <td>@(d.Telefono ?? "—")</td>
                        <td>@d.Citas</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-page="Editar" asp-route-id="@d.IdDentista">Editar</a>
                            <form method="post" asp-page-handler="Eliminar" asp-route-id="@d.IdDentista" class="d-inline"
                                  onsubmit="return confirm('¿Eliminar a @d.NombreCompleto?');">
                                <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
