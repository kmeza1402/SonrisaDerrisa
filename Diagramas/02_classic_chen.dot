graph chen {
  graph [layout=neato, overlap=false, sep="+12", splines=true, pad=0.4, fontname="Helvetica", labelloc=t, fontsize=20, label="DER - Notación Classic (Chen)"];
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=11];
  especialidad [shape=box, style=filled, fillcolor="#e8f4f1", fontsize=13, label="especialidad"];
  "especialidad.id_especialidad" [shape=ellipse, label=<<U>id_especialidad</U>>];
  especialidad -- "especialidad.id_especialidad";
  "especialidad.nombre" [shape=ellipse, label="nombre"];
  especialidad -- "especialidad.nombre";
  paciente [shape=box, style=filled, fillcolor="#e8f4f1", fontsize=13, label="paciente"];
  "paciente.id_paciente" [shape=ellipse, label=<<U>id_paciente</U>>];
  paciente -- "paciente.id_paciente";
  "paciente.nombre" [shape=ellipse, label="nombre"];
  paciente -- "paciente.nombre";
  "paciente.apellidos" [shape=ellipse, label="apellidos"];
  paciente -- "paciente.apellidos";
  "paciente.fecha_nacimiento" [shape=ellipse, label="fecha_nacimiento", style=dashed];
  paciente -- "paciente.fecha_nacimiento";
  "paciente.telefono" [shape=ellipse, label="telefono"];
  paciente -- "paciente.telefono";
  "paciente.correo" [shape=ellipse, label="correo", style=dashed];
  paciente -- "paciente.correo";
  "paciente.fecha_registro" [shape=ellipse, label="fecha_registro"];
  paciente -- "paciente.fecha_registro";
  historial_clinico [shape=box, peripheries=2, fontsize=13, label="historial_clinico"];
  "historial_clinico.id_historial" [shape=ellipse, label=<<U>id_historial</U>>];
  historial_clinico -- "historial_clinico.id_historial";
  "historial_clinico.alergias" [shape=ellipse, label="alergias", style=dashed];
  historial_clinico -- "historial_clinico.alergias";
  "historial_clinico.enfermedades" [shape=ellipse, label="enfermedades", style=dashed];
  historial_clinico -- "historial_clinico.enfermedades";
  "historial_clinico.medicamentos" [shape=ellipse, label="medicamentos", style=dashed];
  historial_clinico -- "historial_clinico.medicamentos";
  "historial_clinico.fecha_actualizacion" [shape=ellipse, label="fecha_actualizacion"];
  historial_clinico -- "historial_clinico.fecha_actualizacion";
  dentista [shape=box, style=filled, fillcolor="#e8f4f1", fontsize=13, label="dentista"];
  "dentista.id_dentista" [shape=ellipse, label=<<U>id_dentista</U>>];
  dentista -- "dentista.id_dentista";
  "dentista.nombre" [shape=ellipse, label="nombre"];
  dentista -- "dentista.nombre";
  "dentista.apellidos" [shape=ellipse, label="apellidos"];
  dentista -- "dentista.apellidos";
  "dentista.cedula" [shape=ellipse, label="cedula"];
  dentista -- "dentista.cedula";
  "dentista.telefono" [shape=ellipse, label="telefono", style=dashed];
  dentista -- "dentista.telefono";
  tratamiento [shape=box, style=filled, fillcolor="#e8f4f1", fontsize=13, label="tratamiento"];
  "tratamiento.id_tratamiento" [shape=ellipse, label=<<U>id_tratamiento</U>>];
  tratamiento -- "tratamiento.id_tratamiento";
  "tratamiento.nombre" [shape=ellipse, label="nombre"];
  tratamiento -- "tratamiento.nombre";
  "tratamiento.descripcion" [shape=ellipse, label="descripcion", style=dashed];
  tratamiento -- "tratamiento.descripcion";
  "tratamiento.precio_base" [shape=ellipse, label="precio_base"];
  tratamiento -- "tratamiento.precio_base";
  cita [shape=box, style=filled, fillcolor="#e8f4f1", fontsize=13, label="cita"];
  "cita.id_cita" [shape=ellipse, label=<<U>id_cita</U>>];
  cita -- "cita.id_cita";
  "cita.fecha" [shape=ellipse, label="fecha"];
  cita -- "cita.fecha";
  "cita.hora" [shape=ellipse, label="hora"];
  cita -- "cita.hora";
  "cita.motivo" [shape=ellipse, label="motivo", style=dashed];
  cita -- "cita.motivo";
  "cita.estado" [shape=ellipse, label="estado"];
  cita -- "cita.estado";
  detalle_cita [shape=box, style="rounded,filled", fillcolor="#e8f4f1", fontsize=13, label="detalle_cita"];
  "detalle_cita.id_detalle" [shape=ellipse, label=<<U>id_detalle</U>>];
  detalle_cita -- "detalle_cita.id_detalle";
  "detalle_cita.diente" [shape=ellipse, label="diente", style=dashed];
  detalle_cita -- "detalle_cita.diente";
  "detalle_cita.precio_aplicado" [shape=ellipse, label="precio_aplicado"];
  detalle_cita -- "detalle_cita.precio_aplicado";
  pago [shape=box, style=filled, fillcolor="#e8f4f1", fontsize=13, label="pago"];
  "pago.id_pago" [shape=ellipse, label=<<U>id_pago</U>>];
  pago -- "pago.id_pago";
  "pago.fecha_pago" [shape=ellipse, label="fecha_pago"];
  pago -- "pago.fecha_pago";
  "pago.monto" [shape=ellipse, label="monto"];
  pago -- "pago.monto";
  "pago.metodo_pago" [shape=ellipse, label="metodo_pago"];
  pago -- "pago.metodo_pago";
  r_especialidad_dentista [shape=diamond, style=filled, fillcolor="#fff2cc", label="agrupa"];
  especialidad -- r_especialidad_dentista [label="1"];
  r_especialidad_dentista -- dentista [label="N"];
  r_paciente_historial_clinico [shape=diamond, style=filled, fillcolor="#fff2cc", label="tiene", peripheries=2];
  paciente -- r_paciente_historial_clinico [label="1"];
  r_paciente_historial_clinico -- historial_clinico [label="1"];
  r_paciente_cita [shape=diamond, style=filled, fillcolor="#fff2cc", label="solicita"];
  paciente -- r_paciente_cita [label="1"];
  r_paciente_cita -- cita [label="N"];
  r_dentista_cita [shape=diamond, style=filled, fillcolor="#fff2cc", label="atiende"];
  dentista -- r_dentista_cita [label="1"];
  r_dentista_cita -- cita [label="N"];
  r_cita_detalle_cita [shape=diamond, style=filled, fillcolor="#fff2cc", label="incluye"];
  cita -- r_cita_detalle_cita [label="1"];
  r_cita_detalle_cita -- detalle_cita [label="N"];
  r_tratamiento_detalle_cita [shape=diamond, style=filled, fillcolor="#fff2cc", label="se aplica en"];
  tratamiento -- r_tratamiento_detalle_cita [label="1"];
  r_tratamiento_detalle_cita -- detalle_cita [label="N"];
  r_cita_pago [shape=diamond, style=filled, fillcolor="#fff2cc", label="se liquida con"];
  cita -- r_cita_pago [label="1"];
  r_cita_pago -- pago [label="N"];
}
