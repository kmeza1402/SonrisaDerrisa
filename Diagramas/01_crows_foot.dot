digraph crows_foot {
  graph [rankdir=LR, splines=ortho, nodesep=0.6, ranksep=1.1, pad=0.3, fontname="Helvetica", labelloc=t, fontsize=20, label="DER - Notación Crow's Foot"];
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];
  especialidad [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#0f6e8c"><FONT COLOR="white"><B>especialidad</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>id_especialidad</U></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(50)</FONT></TD></TR></TABLE>>];
  paciente [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#0f6e8c"><FONT COLOR="white"><B>paciente</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>id_paciente</U></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">apellidos</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">fecha_nacimiento</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">telefono</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(15)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">correo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">fecha_registro</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DATE</FONT></TD></TR></TABLE>>];
  historial_clinico [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#0f6e8c"><FONT COLOR="white"><B>historial_clinico</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>id_historial</U></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_paciente</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">alergias</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">enfermedades</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">medicamentos</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">fecha_actualizacion</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DATE</FONT></TD></TR></TABLE>>];
  dentista [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#0f6e8c"><FONT COLOR="white"><B>dentista</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>id_dentista</U></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">apellidos</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">cedula</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">telefono</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(15)</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_especialidad</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
  tratamiento [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#0f6e8c"><FONT COLOR="white"><B>tratamiento</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>id_tratamiento</U></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">descripcion</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">precio_base</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DECIMAL(10,2)</FONT></TD></TR></TABLE>>];
  cita [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#0f6e8c"><FONT COLOR="white"><B>cita</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>id_cita</U></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_paciente</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_dentista</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">fecha</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">hora</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TIME</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">motivo</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(15)</FONT></TD></TR></TABLE>>];
  detalle_cita [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#0f6e8c"><FONT COLOR="white"><B>detalle_cita</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>id_detalle</U></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_cita</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_tratamiento</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">diente</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(5)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">precio_aplicado</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DECIMAL(10,2)</FONT></TD></TR></TABLE>>];
  pago [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#0f6e8c"><FONT COLOR="white"><B>pago</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>id_pago</U></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_cita</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">fecha_pago</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">monto</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">metodo_pago</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(15)</FONT></TD></TR></TABLE>>];
  especialidad -> dentista [dir=both, arrowtail=teetee, arrowhead=crowodot, xlabel="agrupa"];
  paciente -> historial_clinico [dir=both, arrowtail=teetee, arrowhead=teeodot, xlabel="tiene"];
  paciente -> cita [dir=both, arrowtail=teetee, arrowhead=crowodot, xlabel="solicita"];
  dentista -> cita [dir=both, arrowtail=teetee, arrowhead=crowodot, xlabel="atiende"];
  cita -> detalle_cita [dir=both, arrowtail=teetee, arrowhead=crowodot, xlabel="incluye"];
  tratamiento -> detalle_cita [dir=both, arrowtail=teetee, arrowhead=crowodot, xlabel="se aplica en"];
  cita -> pago [dir=both, arrowtail=teetee, arrowhead=crowodot, xlabel="se liquida con"];
}
