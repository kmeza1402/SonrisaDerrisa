digraph connect_columns {
  graph [rankdir=LR, nodesep=0.6, ranksep=1.1, pad=0.3, fontname="Helvetica", labelloc=t, fontsize=20, label="Modelo relacional - Notación Connect to Columns", splines=true];
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];
  especialidad [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#0f6e8c"><FONT COLOR="white"><B>especialidad</B></FONT></TD></TR><TR><TD PORT="id_especialidad" ALIGN="LEFT" BGCOLOR="#d9ead3">id_especialidad (PK)</TD></TR><TR><TD PORT="nombre" ALIGN="LEFT" BGCOLOR="white">nombre</TD></TR></TABLE>>];
  paciente [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#0f6e8c"><FONT COLOR="white"><B>paciente</B></FONT></TD></TR><TR><TD PORT="id_paciente" ALIGN="LEFT" BGCOLOR="#d9ead3">id_paciente (PK)</TD></TR><TR><TD PORT="nombre" ALIGN="LEFT" BGCOLOR="white">nombre</TD></TR><TR><TD PORT="apellidos" ALIGN="LEFT" BGCOLOR="white">apellidos</TD></TR><TR><TD PORT="fecha_nacimiento" ALIGN="LEFT" BGCOLOR="white">fecha_nacimiento</TD></TR><TR><TD PORT="telefono" ALIGN="LEFT" BGCOLOR="white">telefono</TD></TR><TR><TD PORT="correo" ALIGN="LEFT" BGCOLOR="white">correo</TD></TR><TR><TD PORT="fecha_registro" ALIGN="LEFT" BGCOLOR="white">fecha_registro</TD></TR></TABLE>>];
  historial_clinico [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#0f6e8c"><FONT COLOR="white"><B>historial_clinico</B></FONT></TD></TR><TR><TD PORT="id_historial" ALIGN="LEFT" BGCOLOR="#d9ead3">id_historial (PK)</TD></TR><TR><TD PORT="id_paciente" ALIGN="LEFT" BGCOLOR="#fce5cd">id_paciente (FK)</TD></TR><TR><TD PORT="alergias" ALIGN="LEFT" BGCOLOR="white">alergias</TD></TR><TR><TD PORT="enfermedades" ALIGN="LEFT" BGCOLOR="white">enfermedades</TD></TR><TR><TD PORT="medicamentos" ALIGN="LEFT" BGCOLOR="white">medicamentos</TD></TR><TR><TD PORT="fecha_actualizacion" ALIGN="LEFT" BGCOLOR="white">fecha_actualizacion</TD></TR></TABLE>>];
  dentista [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#0f6e8c"><FONT COLOR="white"><B>dentista</B></FONT></TD></TR><TR><TD PORT="id_dentista" ALIGN="LEFT" BGCOLOR="#d9ead3">id_dentista (PK)</TD></TR><TR><TD PORT="nombre" ALIGN="LEFT" BGCOLOR="white">nombre</TD></TR><TR><TD PORT="apellidos" ALIGN="LEFT" BGCOLOR="white">apellidos</TD></TR><TR><TD PORT="cedula" ALIGN="LEFT" BGCOLOR="white">cedula</TD></TR><TR><TD PORT="telefono" ALIGN="LEFT" BGCOLOR="white">telefono</TD></TR><TR><TD PORT="id_especialidad" ALIGN="LEFT" BGCOLOR="#fce5cd">id_especialidad (FK)</TD></TR></TABLE>>];
  tratamiento [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#0f6e8c"><FONT COLOR="white"><B>tratamiento</B></FONT></TD></TR><TR><TD PORT="id_tratamiento" ALIGN="LEFT" BGCOLOR="#d9ead3">id_tratamiento (PK)</TD></TR><TR><TD PORT="nombre" ALIGN="LEFT" BGCOLOR="white">nombre</TD></TR><TR><TD PORT="descripcion" ALIGN="LEFT" BGCOLOR="white">descripcion</TD></TR><TR><TD PORT="precio_base" ALIGN="LEFT" BGCOLOR="white">precio_base</TD></TR></TABLE>>];
  cita [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#0f6e8c"><FONT COLOR="white"><B>cita</B></FONT></TD></TR><TR><TD PORT="id_cita" ALIGN="LEFT" BGCOLOR="#d9ead3">id_cita (PK)</TD></TR><TR><TD PORT="id_paciente" ALIGN="LEFT" BGCOLOR="#fce5cd">id_paciente (FK)</TD></TR><TR><TD PORT="id_dentista" ALIGN="LEFT" BGCOLOR="#fce5cd">id_dentista (FK)</TD></TR><TR><TD PORT="fecha" ALIGN="LEFT" BGCOLOR="white">fecha</TD></TR><TR><TD PORT="hora" ALIGN="LEFT" BGCOLOR="white">hora</TD></TR><TR><TD PORT="motivo" ALIGN="LEFT" BGCOLOR="white">motivo</TD></TR><TR><TD PORT="estado" ALIGN="LEFT" BGCOLOR="white">estado</TD></TR></TABLE>>];
  detalle_cita [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#0f6e8c"><FONT COLOR="white"><B>detalle_cita</B></FONT></TD></TR><TR><TD PORT="id_detalle" ALIGN="LEFT" BGCOLOR="#d9ead3">id_detalle (PK)</TD></TR><TR><TD PORT="id_cita" ALIGN="LEFT" BGCOLOR="#fce5cd">id_cita (FK)</TD></TR><TR><TD PORT="id_tratamiento" ALIGN="LEFT" BGCOLOR="#fce5cd">id_tratamiento (FK)</TD></TR><TR><TD PORT="diente" ALIGN="LEFT" BGCOLOR="white">diente</TD></TR><TR><TD PORT="precio_aplicado" ALIGN="LEFT" BGCOLOR="white">precio_aplicado</TD></TR></TABLE>>];
  pago [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#0f6e8c"><FONT COLOR="white"><B>pago</B></FONT></TD></TR><TR><TD PORT="id_pago" ALIGN="LEFT" BGCOLOR="#d9ead3">id_pago (PK)</TD></TR><TR><TD PORT="id_cita" ALIGN="LEFT" BGCOLOR="#fce5cd">id_cita (FK)</TD></TR><TR><TD PORT="fecha_pago" ALIGN="LEFT" BGCOLOR="white">fecha_pago</TD></TR><TR><TD PORT="monto" ALIGN="LEFT" BGCOLOR="white">monto</TD></TR><TR><TD PORT="metodo_pago" ALIGN="LEFT" BGCOLOR="white">metodo_pago</TD></TR></TABLE>>];
  especialidad:id_especialidad:e -> dentista:id_especialidad:w [dir=back, arrowtail=normal, color="#3c78d8"];
  paciente:id_paciente:e -> historial_clinico:id_paciente:w [dir=back, arrowtail=normal, color="#3c78d8"];
  paciente:id_paciente:e -> cita:id_paciente:w [dir=back, arrowtail=normal, color="#3c78d8"];
  dentista:id_dentista:e -> cita:id_dentista:w [dir=back, arrowtail=normal, color="#3c78d8"];
  cita:id_cita:e -> detalle_cita:id_cita:w [dir=back, arrowtail=normal, color="#3c78d8"];
  tratamiento:id_tratamiento:e -> detalle_cita:id_tratamiento:w [dir=back, arrowtail=normal, color="#3c78d8"];
  cita:id_cita:e -> pago:id_cita:w [dir=back, arrowtail=normal, color="#3c78d8"];
}
