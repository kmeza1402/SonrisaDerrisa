digraph idef1x {
  graph [rankdir=LR, splines=polyline, nodesep=0.6, ranksep=1.1, pad=0.3, fontname="Helvetica", labelloc=t, fontsize=20, label="Modelo - Notación IDEF1X"];
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];
  especialidad [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>especialidad</B></TD></TR><TR><TD><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" SIDES="LTRB"><TR><TD ALIGN="LEFT" SIDES="B" BORDER="1">id_especialidad<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">nombre<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
  paciente [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>paciente</B></TD></TR><TR><TD><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" SIDES="LTRB"><TR><TD ALIGN="LEFT" SIDES="B" BORDER="1">id_paciente<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">nombre<BR ALIGN="LEFT"/>apellidos<BR ALIGN="LEFT"/>fecha_nacimiento<BR ALIGN="LEFT"/>telefono<BR ALIGN="LEFT"/>correo<BR ALIGN="LEFT"/>fecha_registro<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
  historial_clinico [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>historial_clinico</B></TD></TR><TR><TD><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" SIDES="LTRB"><TR><TD ALIGN="LEFT" SIDES="B" BORDER="1">id_historial<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">id_paciente (FK)<BR ALIGN="LEFT"/>alergias<BR ALIGN="LEFT"/>enfermedades<BR ALIGN="LEFT"/>medicamentos<BR ALIGN="LEFT"/>fecha_actualizacion<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
  dentista [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>dentista</B></TD></TR><TR><TD><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" SIDES="LTRB"><TR><TD ALIGN="LEFT" SIDES="B" BORDER="1">id_dentista<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">nombre<BR ALIGN="LEFT"/>apellidos<BR ALIGN="LEFT"/>cedula<BR ALIGN="LEFT"/>telefono<BR ALIGN="LEFT"/>id_especialidad (FK)<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
  tratamiento [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>tratamiento</B></TD></TR><TR><TD><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" SIDES="LTRB"><TR><TD ALIGN="LEFT" SIDES="B" BORDER="1">id_tratamiento<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">nombre<BR ALIGN="LEFT"/>descripcion<BR ALIGN="LEFT"/>precio_base<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
  cita [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>cita</B></TD></TR><TR><TD><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" SIDES="LTRB"><TR><TD ALIGN="LEFT" SIDES="B" BORDER="1">id_cita<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">id_paciente (FK)<BR ALIGN="LEFT"/>id_dentista (FK)<BR ALIGN="LEFT"/>fecha<BR ALIGN="LEFT"/>hora<BR ALIGN="LEFT"/>motivo<BR ALIGN="LEFT"/>estado<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
  detalle_cita [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>detalle_cita</B></TD></TR><TR><TD><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" SIDES="LTRB"><TR><TD ALIGN="LEFT" SIDES="B" BORDER="1">id_detalle<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">id_cita (FK)<BR ALIGN="LEFT"/>id_tratamiento (FK)<BR ALIGN="LEFT"/>diente<BR ALIGN="LEFT"/>precio_aplicado<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
  pago [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0"><TR><TD ALIGN="LEFT"><B>pago</B></TD></TR><TR><TD><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" SIDES="LTRB"><TR><TD ALIGN="LEFT" SIDES="B" BORDER="1">id_pago<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">id_cita (FK)<BR ALIGN="LEFT"/>fecha_pago<BR ALIGN="LEFT"/>monto<BR ALIGN="LEFT"/>metodo_pago<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
  especialidad -> dentista [style=dashed, dir=both, arrowhead=dot, arrowtail=none, headlabel="", label="agrupa"];
  paciente -> historial_clinico [style=dashed, dir=both, arrowhead=dot, arrowtail=none, headlabel="Z", label="tiene"];
  paciente -> cita [style=dashed, dir=both, arrowhead=dot, arrowtail=none, headlabel="", label="solicita"];
  dentista -> cita [style=dashed, dir=both, arrowhead=dot, arrowtail=none, headlabel="", label="atiende"];
  cita -> detalle_cita [style=dashed, dir=both, arrowhead=dot, arrowtail=none, headlabel="", label="incluye"];
  tratamiento -> detalle_cita [style=dashed, dir=both, arrowhead=dot, arrowtail=none, headlabel="", label="se aplica en"];
  cita -> pago [style=dashed, dir=both, arrowhead=dot, arrowtail=none, headlabel="", label="se liquida con"];
}
