digraph uml {
  graph [rankdir=LR, splines=polyline, nodesep=0.6, ranksep=1.1, pad=0.3, fontname="Helvetica", labelloc=t, fontsize=20, label="Diagrama de clases - Notación UML"];
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];
  especialidad [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#fff2cc"><B>Especialidad</B></TD></TR><TR><TD ALIGN="LEFT">+ id_especialidad : INT {PK}<BR ALIGN="LEFT"/>- nombre : VARCHAR(50)<BR ALIGN="LEFT"/></TD></TR><TR><TD> </TD></TR></TABLE>>];
  paciente [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#fff2cc"><B>Paciente</B></TD></TR><TR><TD ALIGN="LEFT">+ id_paciente : INT {PK}<BR ALIGN="LEFT"/>- nombre : VARCHAR(50)<BR ALIGN="LEFT"/>- apellidos : VARCHAR(80)<BR ALIGN="LEFT"/>- fecha_nacimiento : DATE [0..1]<BR ALIGN="LEFT"/>- telefono : VARCHAR(15)<BR ALIGN="LEFT"/>- correo : VARCHAR(100) [0..1]<BR ALIGN="LEFT"/>- fecha_registro : DATE<BR ALIGN="LEFT"/></TD></TR><TR><TD> </TD></TR></TABLE>>];
  historial_clinico [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#fff2cc">&laquo;débil&raquo;<BR/><B>Historial_clinico</B></TD></TR><TR><TD ALIGN="LEFT">+ id_historial : INT {PK}<BR ALIGN="LEFT"/>- id_paciente : INT {FK}<BR ALIGN="LEFT"/>- alergias : VARCHAR(200) [0..1]<BR ALIGN="LEFT"/>- enfermedades : VARCHAR(200) [0..1]<BR ALIGN="LEFT"/>- medicamentos : VARCHAR(200) [0..1]<BR ALIGN="LEFT"/>- fecha_actualizacion : DATE<BR ALIGN="LEFT"/></TD></TR><TR><TD> </TD></TR></TABLE>>];
  dentista [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#fff2cc"><B>Dentista</B></TD></TR><TR><TD ALIGN="LEFT">+ id_dentista : INT {PK}<BR ALIGN="LEFT"/>- nombre : VARCHAR(50)<BR ALIGN="LEFT"/>- apellidos : VARCHAR(80)<BR ALIGN="LEFT"/>- cedula : VARCHAR(20)<BR ALIGN="LEFT"/>- telefono : VARCHAR(15) [0..1]<BR ALIGN="LEFT"/>- id_especialidad : INT {FK}<BR ALIGN="LEFT"/></TD></TR><TR><TD> </TD></TR></TABLE>>];
  tratamiento [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#fff2cc"><B>Tratamiento</B></TD></TR><TR><TD ALIGN="LEFT">+ id_tratamiento : INT {PK}<BR ALIGN="LEFT"/>- nombre : VARCHAR(60)<BR ALIGN="LEFT"/>- descripcion : VARCHAR(200) [0..1]<BR ALIGN="LEFT"/>- precio_base : DECIMAL(10,2)<BR ALIGN="LEFT"/></TD></TR><TR><TD> </TD></TR></TABLE>>];
  cita [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#fff2cc"><B>Cita</B></TD></TR><TR><TD ALIGN="LEFT">+ id_cita : INT {PK}<BR ALIGN="LEFT"/>- id_paciente : INT {FK}<BR ALIGN="LEFT"/>- id_dentista : INT {FK}<BR ALIGN="LEFT"/>- fecha : DATE<BR ALIGN="LEFT"/>- hora : TIME<BR ALIGN="LEFT"/>- motivo : VARCHAR(150) [0..1]<BR ALIGN="LEFT"/>- estado : VARCHAR(15)<BR ALIGN="LEFT"/></TD></TR><TR><TD> </TD></TR></TABLE>>];
  detalle_cita [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#fff2cc">&laquo;asociativa&raquo;<BR/><B>Detalle_cita</B></TD></TR><TR><TD ALIGN="LEFT">+ id_detalle : INT {PK}<BR ALIGN="LEFT"/>- id_cita : INT {FK}<BR ALIGN="LEFT"/>- id_tratamiento : INT {FK}<BR ALIGN="LEFT"/>- diente : VARCHAR(5) [0..1]<BR ALIGN="LEFT"/>- precio_aplicado : DECIMAL(10,2)<BR ALIGN="LEFT"/></TD></TR><TR><TD> </TD></TR></TABLE>>];
  pago [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#fff2cc"><B>Pago</B></TD></TR><TR><TD ALIGN="LEFT">+ id_pago : INT {PK}<BR ALIGN="LEFT"/>- id_cita : INT {FK}<BR ALIGN="LEFT"/>- fecha_pago : DATE<BR ALIGN="LEFT"/>- monto : DECIMAL(10,2)<BR ALIGN="LEFT"/>- metodo_pago : VARCHAR(15)<BR ALIGN="LEFT"/></TD></TR><TR><TD> </TD></TR></TABLE>>];
  especialidad -> dentista [arrowhead=none, taillabel="1", headlabel="0..*", label="agrupa"];
  paciente -> historial_clinico [arrowhead=none, taillabel="1", headlabel="0..1", label="tiene"];
  paciente -> cita [arrowhead=none, taillabel="1", headlabel="0..*", label="solicita"];
  dentista -> cita [arrowhead=none, taillabel="1", headlabel="0..*", label="atiende"];
  cita -> detalle_cita [arrowhead=none, taillabel="1", headlabel="0..*", label="incluye"];
  tratamiento -> detalle_cita [arrowhead=none, taillabel="1", headlabel="0..*", label="se aplica en"];
  cita -> pago [arrowhead=none, taillabel="1", headlabel="0..*", label="se liquida con"];
}
